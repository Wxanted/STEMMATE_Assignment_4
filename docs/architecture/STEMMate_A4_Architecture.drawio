        <mxCell id="m13" value="11. &quot;Saved and synced&quot;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1">
