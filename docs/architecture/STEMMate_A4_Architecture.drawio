  <diagram id="p6" name="7 Offline and Failure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="7. Offline, synchronisation and failure strategy" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Purpose: define behaviour when things go wrong.   Serves: FR-04, FR-08, QR-03, QR-06." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="o0_0" value="Situation" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o0_1" value="What happens" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o1_0" value="No internet when saving" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o1_1" value="Saved on the phone, shown as Pending, sent automatically later." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o2_0" value="Response lost after the server saved" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o2_1" value="Retry reuses the same recordId; the server answers &quot;duplicate&quot;. No double count." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3_0" value="Server down or restarting" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3_1" value="Record stays Pending and retries. Nothing is deleted." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o4_0" value="Server rejects the data" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o4_1" value="Record shown as Failed with the reason. Facilitator can fix and retry." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o5_0" value="App closed or battery dies mid-marking" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o5_1" value="The draft is restored when the roster is reopened." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="350" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o6_0" value="Two phones save the same session and date" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o6_1" value="The later recordedAt wins; the older record is kept and marked superseded." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o7_0" value="Server disk fails" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o7_1" value="Restore the last backup file. Phones still holding unsent records send them again." style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
