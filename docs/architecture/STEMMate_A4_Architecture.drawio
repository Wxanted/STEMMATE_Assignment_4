            <mxPoint x="480" y="206" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="3. write record (Pending)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1">
