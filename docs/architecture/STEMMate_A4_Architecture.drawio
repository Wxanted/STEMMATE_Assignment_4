            <mxPoint x="290" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt" value="Branches (draw as UML alt boxes):&#xa;• Invalid input at step 2: error shown, nothing written.&#xa;• Offline at step 6: record stays Pending and retries later.&#xa;• Server rejects (4xx): record marked Failed with the reason, never deleted." style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="640" width="820" height="100" as="geometry" />
