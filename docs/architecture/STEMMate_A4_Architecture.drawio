        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="7. Offline, synchronisation and failure strategy" vertex="1">
          <mxGeometry height="34" width="900" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" value="Purpose: behaviour during offline use, sync failures and recovery. Serves: FR-03, FR-04, FR-05, QR-02, PR-01, SR-01, AR-01." vertex="1">
          <mxGeometry height="24" width="900" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="o0_0" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Situation" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="o0_1" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="What happens" vertex="1">
          <mxGeometry height="52" width="600" x="380" y="100" as="geometry" />
        </mxCell>
        <mxCell id="o1_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="No internet when saving" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="152" as="geometry" />
        </mxCell>
        <mxCell id="o1_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Plan saved on device, shown as Pending, automatically sent later (FR-05)." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="152" as="geometry" />
        </mxCell>
        <mxCell id="o2_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Response lost after the server saved" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="204" as="geometry" />
        </mxCell>
        <mxCell id="o2_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Retry reuses the same planId; server recognises duplicate and avoids a second copy. Verify with a test." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="204" as="geometry" />
        </mxCell>
        <mxCell id="o3_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Server down or restarting" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="256" as="geometry" />
        </mxCell>
        <mxCell id="o3_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Plan stays Pending and retries. Nothing is deleted." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="256" as="geometry" />
        </mxCell>
        <mxCell id="o4_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Server rejects the data" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="308" as="geometry" />
        </mxCell>
        <mxCell id="o4_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Plan shown as Failed with the reason. Local copy kept; facilitator can fix and retry." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="308" as="geometry" />
        </mxCell>
        <mxCell id="o5_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="App closed or battery dies mid-edit" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="o5_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Restore the last locally autosaved draft when reopened (FR-04)." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="360" as="geometry" />
        </mxCell>
        <mxCell id="o6_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Same plan edited on two devices" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="412" as="geometry" />
        </mxCell>
        <mxCell id="o6_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Show conflict comparison. Facilitator chooses Keep Local, Keep Remote or Merge. Retain the local draft; never silently overwrite it (A3 baseline)." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="412" as="geometry" />
        </mxCell>
        <mxCell id="o7_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Shared device, second facilitator signs in" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="464" as="geometry" />
        </mxCell>
        <mxCell id="o7_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Only the signed-in facilitator&#39;s own workspace is visible; another profile cannot access it without signing in (SR-01)." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="464" as="geometry" />
        </mxCell>
        <mxCell id="o8_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Device storage full" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="516" as="geometry" />
        </mxCell>
        <mxCell id="o8_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Show a clear Save Failed message and options to free space/retry. Do not report success or overwrite existing data." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="516" as="geometry" />
        </mxCell>
        <mxCell id="o9_0" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Server disk fails" vertex="1">
          <mxGeometry height="52" width="340" x="40" y="568" as="geometry" />
        </mxCell>
        <mxCell id="o9_1" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="Restore from the last backup; unsent phone plans remain queued for retry. Backup/restore still requires implementation and testing." vertex="1">
          <mxGeometry height="52" width="600" x="380" y="568" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p7" name="8 ADRs">
    <mxGraphModel dx="1323" dy="698" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="8. Architecture Decision Records (user-stated choices)" vertex="1">
          <mxGeometry height="34" width="900" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="a0h" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="ADR-01 — Platform: PWA" vertex="1">
          <mxGeometry height="36" width="420" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="a0b" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=11;spacing=6;" value="Context: offline-first use on shared, low-spec Android devices.&lt;br&gt;Options: online-only web; native Android; offline-first PWA.&lt;br&gt;My decision: PWA.&lt;br&gt;My stated general reason: because it considers users with shared devices.&lt;br&gt;Implications to verify: offline app/activity access and browser/device compatibility.&lt;br&gt;Team approval: not confirmed. Owner: Dinilson." vertex="1">
          <mxGeometry height="230" width="420" x="40" y="136" as="geometry" />
        </mxCell>
        <mxCell id="a1h" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="ADR-02 — Synchronisation: local-first" vertex="1">
          <mxGeometry height="36" width="420" x="480" y="100" as="geometry" />
        </mxCell>
        <mxCell id="a1b" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=11;spacing=6;" value="Context: plans must remain available offline and sync later (FR-04/FR-05).&lt;br&gt;Options: send immediately; save locally and queue sync.&lt;br&gt;My decision: local-first, then queued sync when online.&lt;br&gt;My stated general reason: because it considers users with intermittent connectivity.&lt;br&gt;Verify: stable planId, retries, status and duplicate prevention.&lt;br&gt;Team approval: not confirmed. Owner: Dinilson." vertex="1">
          <mxGeometry height="230" width="420" x="480" y="136" as="geometry" />
        </mxCell>
        <mxCell id="a2h" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="ADR-03 — Conflict policy: facilitator chooses" vertex="1">
          <mxGeometry height="36" width="420" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="a2b" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=11;spacing=6;" value="Context: the same plan may be edited on two devices (FR-05).&lt;br&gt;Options: newest edit wins; facilitator chooses Keep Local / Keep Remote / Merge.&lt;br&gt;My decision: facilitator chooses.&lt;br&gt;My stated general reason: “Authentication and Authorization.”&lt;br&gt;Verify: show comparison and retain local draft until resolved.&lt;br&gt;Team approval: not confirmed. Owner: Dinilson." vertex="1">
          <mxGeometry height="230" width="420" x="40" y="436" as="geometry" />
        </mxCell>
        <mxCell id="a3h" parent="1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" value="ADR-04 — Storage: SQLite" vertex="1">
          <mxGeometry height="36" width="420" x="480" y="400" as="geometry" />
        </mxCell>
        <mxCell id="a3b" parent="1" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=11;spacing=6;" value="Context: synchronised plans need persistent storage.&lt;br&gt;Options: hosted DB; PostgreSQL server; SQLite file.&lt;br&gt;My decision: SQLite. Proposed deployment: SQLite file on the small server; confirm location with team.&lt;br&gt;My stated general reason: Preserve consistency.&lt;br&gt;Verify: persistence, backup/restore, access and concurrent sync.&lt;br&gt;Team approval: not confirmed. Owner: Dinilson." vertex="1">
          <mxGeometry height="230" width="420" x="480" y="436" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
