        <mxCell id="a0h" value="ADR-01 Offline-first web app" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a0b" value="Context: weak or no internet, low-cost phones (QR-05).&#xa;Options: (A) online-only web app; (B) native Android app; (C) offline-first web app (PWA).&#xa;Decision: ______&#xa;Consequences (+/-): ______&#xa;Owner: ______" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="136" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a1h" value="ADR-02 Write locally first, then sync" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a1b" value="Context: saves must survive crashes and lost connections (QR-03).&#xa;Options: (A) send immediately; (B) local outbox with retry and a record ID.&#xa;Decision: ______&#xa;Consequences (+/-): ______&#xa;Owner: ______" style="fillColor=#ffffff;strokeColor=#999999;align=left;whiteSpace=wrap;html=1;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="136" width="420" height="230" as="geometry" />
