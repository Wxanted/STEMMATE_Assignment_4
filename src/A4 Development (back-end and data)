<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STEMMate Namibia - Vertical Slice (Tasks 10-12)</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --border-color: #30363d;
            --text-main: #c9d1d9;
            --text-heading: #ffffff;
            --accent-green: #2ea44f;
            --accent-yellow: #d29922;
            --accent-red: #f85149;
            --accent-blue: #58a6ff;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 650px;
        }

        header {
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        h1 {
            color: var(--text-heading);
            font-size: 1.4rem;
            margin: 0 0 5px 0;
        }

        .subtitle {
            font-size: 0.85rem;
            color: #8b949e;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .card h2 {
            font-size: 1.1rem;
            margin-top: 0;
            color: var(--text-heading);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .badge {
            font-size: 0.75rem;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 600;
        }

        .badge-task {
            background-color: #21262d;
            color: var(--accent-blue);
            border: 1px solid var(--accent-blue);
        }

        .form-group {
            margin-bottom: 12px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 4px;
        }

        input[type="text"], input[type="password"], select {
            width: 100%;
            padding: 8px 12px;
            background-color: #0d1117;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-main);
            box-sizing: border-box;
            font-size: 0.9rem;
        }

        button {
            background-color: var(--accent-green);
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.9rem;
            transition: opacity 0.2s;
        }

        button:hover {
            opacity: 0.9;
        }

        button.btn-warning {
            background-color: var(--accent-yellow);
            color: #000;
        }

        button.btn-danger {
            background-color: var(--accent-red);
        }

        .status-banner {
            padding: 10px 14px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .status-synced {
            background-color: rgba(46, 164, 79, 0.15);
            color: #56d364;
            border: 1px solid rgba(46, 164, 79, 0.4);
        }

        .status-pending {
            background-color: rgba(210, 153, 34, 0.15);
            color: #e3b341;
            border: 1px solid rgba(210, 153, 34, 0.4);
        }

        .status-failed {
            background-color: rgba(248, 81, 73, 0.15);
            color: #f85149;
            border: 1px solid rgba(248, 81, 73, 0.4);
        }

        pre {
            background-color: #0d1117;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 12px;
            font-family: monospace;
            font-size: 0.8rem;
            overflow-x: auto;
            color: #7ee787;
            max-height: 200px;
        }

        .roster-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }

        .roster-item {
            background-color: #0d1117;
            padding: 8px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>STEMMate Namibia - Technical Vertical Slice</h1>
        <div class="subtitle">Assigned Developer: Naobeb | Assessment 4 (Tasks 10, 11 & 12)</div>
    </header>

    <!-- LIVE STATUS BANNER (Task 11) -->
    <div id="syncBanner" class="status-banner status-synced">
        <span id="syncBannerText">HOME - SYNCED (Online & Operational)</span>
        <button style="padding: 2px 8px; font-size: 0.75rem;" onclick="app.manualSyncCheck()">Check Status</button>
    </div>

    <!-- TASK 10: LOGIN MODULE -->
    <div class="card">
        <h2>1. Facilitator Login Service <span class="badge badge-task">Task 10</span></h2>
        <div class="form-group">
            <label for="facId">Facilitator ID (Default: FAC-0142)</label>
            <input type="text" id="facId" value="FAC-0142">
        </div>
        <div class="form-group">
            <label for="facPin">Security PIN (4+ digits)</label>
            <input type="password" id="facPin" value="1234">
        </div>
        <button onclick="app.handleLogin()">Authenticate Facilitator</button>
        <button class="btn-warning" onclick="app.handleLogout()">Logout</button>
    </div>

    <!-- TASK 10 & 11: ATTENDANCE & OFFLINE QUEUE -->
    <div class="card">
        <h2>2. Save-Attendance & Validation <span class="badge badge-task">Task 10 & 11</span></h2>
        <div class="form-group">
            <label for="sessionId">Session Identification</label>
            <input type="text" id="sessionId" value="STEM-Grade6-7-Club" readonly>
        </div>
        <label>Learner Roster (Grade 6–7 STEM Club - 18 Enrolled)</label>
        <div class="roster-grid">
            <div class="roster-item">
                <span>Learner 01</span>
                <select id="learner1"><option value="present">Present</option><option value="absent">Absent</option></select>
            </div>
            <div class="roster-item">
                <span>Learner 02</span>
                <select id="learner2"><option value="present">Present</option><option value="absent">Absent</option></select>
            </div>
            <div class="roster-item">
                <span>Learner 03</span>
                <select id="learner3"><option value="absent">Absent</option><option value="present">Present</option></select>
            </div>
            <div class="roster-item">
                <span>Learners 04-18</span>
                <span>(15 Present)</span>
            </div>
        </div>
        <button onclick="app.handleSaveAttendance()">Save Attendance Record</button>
    </div>

    <!-- TASK 11: OFFLINE SIMULATION CONTROLS -->
    <div class="card">
        <h2>3. Failure-Recovery Controls <span class="badge badge-task">Task 11</span></h2>
        <p style="font-size: 0.85rem;">Simulate network conditions to test offline storage and recovery states.</p>
        <button class="btn-warning" onclick="app.toggleSimulatedOffline()">Toggle Offline Mode</button>
        <button class="btn-danger" onclick="app.simulateSyncFailure()">Simulate Sync Conflict</button>
    </div>

    <!-- SYSTEM OUTPUT LOG (Task 12 Execution Proof) -->
    <div class="card">
        <h2>Console & Persistence Output Log <span class="badge badge-task">Task 12</span></h2>
        <pre id="consoleLog">System initializing IndexedDB storage...</pre>
    </div>
</div>

<script>
// ==========================================
// TASK 10: DATA STORAGE MANAGER (IndexedDB)
// ==========================================
class STEMMateStorage {
    constructor() {
        this.dbName = "STEMMateLocalDB";
        this.dbVersion = 1;
        this.db = null;
    }

    async init() {
        return new Promise((resolve, reject) => {
            const request = indexedDB.open(this.dbName, this.dbVersion);
            
            request.onerror = () => reject("Error opening database on device.");
            request.onsuccess = (event) => {
                this.db = event.target.result;
                resolve(this.db);
            };
            
            request.onupgradeneeded = (event) => {
                let db = event.target.result;
                if (!db.objectStoreNames.contains("sessions")) {
                    db.createObjectStore("sessions", { keyPath: "sessionId" });
                }
                if (!db.objectStoreNames.contains("attendance_queue")) {
                    db.createObjectStore("attendance_queue", { keyPath: "recordId", autoIncrement: true });
                }
                if (!db.objectStoreNames.contains("auth_cache")) {
                    db.createObjectStore("auth_cache", { keyPath: "facilitatorId" });
                }
            };
        });
    }

    async saveRecord(storeName, data) {
        if (!this.db) await this.init();
        return new Promise((resolve, reject) => {
            const transaction = this.db.transaction([storeName], "readwrite");
            const store = transaction.objectStore(storeName);
            const request = store.put(data);

            request.onsuccess = () => resolve(true);
            request.onerror = () => reject(request.error);
        });
    }
}

// ==========================================
// TASK 10: AUTHENTICATION SERVICE
// ==========================================
class AuthService {
    constructor(storageInstance) {
        this.storage = storageInstance;
    }

    async login(facilitatorId, pin) {
        if (!facilitatorId || !pin) {
            throw new Error("Facilitator ID and PIN are required.");
        }

        if (facilitatorId === "FAC-0142" && pin.length >= 4) {
            const sessionToken = "token_" + Math.random().toString(36).substring(2) + Date.now();
            
            const authRecord = {
                facilitatorId: facilitatorId,
                token: sessionToken,
                role: "Facilitator",
                loginTime: new Date().toISOString()
            };

            await this.storage.saveRecord("auth_cache", authRecord);
            return { success: true, token: sessionToken, role: "Facilitator" };
        } else {
            throw new Error("Invalid Facilitator ID or PIN. Use FAC-0142.");
        }
    }

    async logout() {
        if (this.storage.db) {
            const transaction = this.storage.db.transaction(["auth_cache"], "readwrite");
            transaction.objectStore("auth_cache").clear();
        }
        return true;
    }
}

// ==========================================
// TASK 10: ATTENDANCE LOGIC & VALIDATION
// ==========================================
class AttendanceService {
    constructor(storageInstance) {
        this.storage = storageInstance;
    }

    async saveAttendance(sessionId, attendanceList) {
        if (!sessionId || !Array.isArray(attendanceList)) {
            throw new Error("Invalid session or attendance format.");
        }

        let presentCount = 0;
        let absentCount = 0;
        let unmarkedCount = 0;

        attendanceList.forEach(item => {
            if (item.status === "present") presentCount++;
            else if (item.status === "absent") absentCount++;
            else unmarkedCount++;
        });

        // FR-05 Data integrity check
        if (presentCount < 0 || absentCount < 0) {
            throw new Error("Participant counts must be non-negative integers.");
        }

        const attendanceRecord = {
            sessionId: sessionId,
            timestamp: new Date().toISOString(),
            summary: {
                present: presentCount,
                absent: absentCount,
                unmarked: unmarkedCount
            },
            roster: attendanceList,
            syncStatus: "PENDING"
        };

        await this.storage.saveRecord("attendance_queue", attendanceRecord);

        return {
            status: "SAVED_LOCAL",
            message: "Attendance saved locally to device. Queued for sync.",
            summary: attendanceRecord.summary
        };
    }
}

// ==========================================
// TASK 11: ERROR HANDLING & SYNC RECOVERY
// ==========================================
class SyncRecoveryManager {
    constructor(storageInstance) {
        this.storage = storageInstance;
        this.forceOffline = false;
        this.forceFail = false;
    }

    async checkAndSync() {
        const isOnline = navigator.onLine && !this.forceOffline;

        if (!isOnline) {
            return {
                status: "PENDING",
                bannerClass: "status-pending",
                message: "HOME - PENDING (No connection. Saved locally on device)"
            };
        }

        if (this.forceFail) {
            return {
                status: "FAILED",
                bannerClass: "status-failed",
                message: "HOME - FAILED (Sync conflict detected. Tap to retry)"
            };
        }

        return {
            status: "SYNCED",
            bannerClass: "status-synced",
            message: "HOME - SYNCED (All records uploaded successfully)"
        };
    }
}

// ==========================================
// TASK 12: APPLICATION ORCHESTRATOR
// ==========================================
class AppOrchestrator {
    constructor() {
        this.storage = new STEMMateStorage();
        this.auth = new AuthService(this.storage);
        this.attendance = new AttendanceService(this.storage);
        this.sync = new SyncRecoveryManager(this.storage);
    }

    async init() {
        try {
            await this.storage.init();
            this.log("IndexedDB initialized successfully.");
            await this.manualSyncCheck();
        } catch (e) {
            this.log("Initialization Error: " + e);
        }
    }

    async handleLogin() {
        const id = document.getElementById("facId").value;
        const pin = document.getElementById("facPin").value;
        try {
            const res = await this.auth.login(id, pin);
            this.log("AUTH SUCCESS: Facilitator logged in. Token: " + res.token);
        } catch (e) {
            this.log("AUTH ERROR: " + e.message);
        }
    }

    async handleLogout() {
        await this.auth.logout();
        this.log("AUTH: Facilitator logged out. Security token cleared.");
    }

    async handleSaveAttendance() {
        const sessionId = document.getElementById("sessionId").value;
        const roster = [
            { learner: "Learner 01", status: document.getElementById("learner1").value },
            { learner: "Learner 02", status: document.getElementById("learner2").value },
            { learner: "Learner 03", status: document.getElementById("learner3").value }
        ];

        // Fill remaining 15 learners as present for full Grade 6-7 STEM Club count
        for (let i = 4; i <= 18; i++) {
            roster.push({ learner: "Learner " + (i < 10 ? "0" + i : i), status: "present" });
        }

        try {
            const result = await this.attendance.saveAttendance(sessionId, roster);
            this.log("ATTENDANCE SAVED: " + JSON.stringify(result.summary));
            await this.manualSyncCheck();
        } catch (e) {
            this.log("SAVE ERROR: " + e.message);
        }
    }

    toggleSimulatedOffline() {
        this.sync.forceOffline = !this.sync.forceOffline;
        this.log("NETWORK SIMULATION: Simulated Offline Mode = " + this.sync.forceOffline);
        this.manualSyncCheck();
    }

    simulateSyncFailure() {
        this.sync.forceFail = !this.sync.forceFail;
        this.log("NETWORK SIMULATION: Sync Failure Triggered = " + this.sync.forceFail);
        this.manualSyncCheck();
    }

    async manualSyncCheck() {
        const status = await this.sync.checkAndSync();
        const banner = document.getElementById("syncBanner");
        const bannerText = document.getElementById("syncBannerText");
        
        banner.className = "status-banner " + status.bannerClass;
        bannerText.innerText = status.message;
    }

    log(msg) {
        const consoleElem = document.getElementById("consoleLog");
        const timestamp = new Date().toLocaleTimeString();
        consoleElem.innerText += `\n[${timestamp}] ${msg}`;
        consoleElem.scrollTop = consoleElem.scrollHeight;
    }
}

const app = new AppOrchestrator();
window.onload = () => app.init();
</script>

</body>
</html>
